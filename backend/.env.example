# Copy this file to .env and fill in real values

# LLM provider (used for feasibility narrative generation in feasibility_engine.py)
ANTHROPIC_API_KEY=your_key_here

# Optional: real data source keys once you move past mock data
DATA_GOV_IN_API_KEY=
AGMARKNET_API_KEY=

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Auth (personal-use login + saved history). Generate a real random string
# before the demo, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-before-demo
